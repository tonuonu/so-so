 function parseCSV(text) {
-  return text.split('\n').map(line => line.split(','));
+  const records = [];
+  let record = [];
+  let field = '';
+  let quoted = false;
+  let pendingRecord = false;
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    if (quoted) {
