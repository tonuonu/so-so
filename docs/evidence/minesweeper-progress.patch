@@ -0,0 +1,224 @@
+/**
+ * DOM-free Minesweeper game logic.
+ * CommonJS + browser global (UMD-lite) export: createGame(seed).
+ */
+(function (root, factory) {
+  if (typeof module === 'object' && module.exports) module.exports = factory();
+  else root.Minesweeper = factory();
+})(typeof self !== 'undefined' ? self : this, function () {
+  'use strict';
+
+  var WIDTH = 9, HEIGHT = 9, MINES = 10;
+
+  /** Deterministic seeded RNG (mulberry32). */
+  function mulberry32(seed) {
+    var a = seed >>> 0;
+    return function () {
+      a |= 0; a = (a + 0x6D2B79F5) | 0;
+      var t = Math.imul(a ^ (a >>> 15), 1 | a);
+      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+    };
+  }
+
+  function createGame(seed) {
+    if (seed === undefined) seed = 1;
+    return new Game(seed);
+  }
+
+  function Game(seed) {
+    this.seed = seed >>> 0;
+    this.width = WIDTH;
+    this.height = HEIGHT;
+    this.mineCount = MINES;
+    this._initialSeed = this.seed;
+    this._init();
+  }
+
+  Game.prototype._init = function () {
+    var rng = mulberry32(this.seed);
+    var total = this.width * this.height;
+    var positions = [];
+    for (var i = 0; i < total; i++) positions.push(i);
+    // Fisher-Yates with seeded RNG for deterministic layout
+    for (var j = total - 1; j > 0; j--) {
+      var k = Math.floor(rng() * (j + 1));
+      var tmp = positions[j]; positions[j] = positions[k]; positions[k] = tmp;
+    }
+    var mineSet = {};
+    for (var m = 0; m < this.mineCount; m++) mineSet[positions[m]] = true;
+
+    this.cells = [];
+    for (var y = 0; y < this.height; y++) {
+      var row = [];
+      for (var x = 0; x < this.width; x++) {
+        var isMine = !!mineSet[y * this.width + x];
+        row.push({
+          x: x, y: y,
+          mine: isMine,
+          revealed: false,
+          flagged: false
+        });
+      }
+      this.cells.push(row);
+    }
+    // neighbor counts
+    for (var yy = 0; yy < this.height; yy++) {
+      for (var xx = 0; xx < this.width; xx++) {
+        this.cells[yy][xx].neighborMines = this._countNeighbors(xx, yy);
+        this.cells[yy][xx].adjacentMines = this.cells[yy][xx].neighborMines;
+      }
+    }
+    this.flags = 0;
+    this.revealedSafe = 0;
+    this.safeCells = total - this.mineCount;
+    this.status = 'playing';
+    this.firstClickPending = true;
+  };
+
+  Game.prototype._inBounds = function (x, y) {
+    return x >= 0 && y >= 0 && x < this.width && y < this.height;
+  };
+
+  Game.prototype._countNeighbors = function (x, y) {
+    var count = 0;
+    for (var dy = -1; dy <= 1; dy++) {
+      for (var dx = -1; dx <= 1; dx++) {
+        if (dx === 0 && dy === 0) continue;
+        var nx = x + dx, ny = y + dy;
+        if (this._inBounds(nx, ny) && this.cells[ny][nx].mine) count++;
+      }
+    }
+    return count;
+  };
+
+  Game.prototype.getCell = function (x, y) {
+    if (!this._inBounds(x, y)) return undefined;
+    var c = this.cells[y][x];
+    // expose convenience aliases
+    if (c.isMine === undefined) {
+      try {
+        Object.defineProperty(c, 'isMine', { get: function () { return this.mine; } });
+        Object.defineProperty(c, 'isRevealed', { get: function () { return this.revealed; } });
+        Object.defineProperty(c, 'isFlagged', { get: function () { return this.flagged; } });
+      } catch (e) { /* older engines: ignore */ }
+    }
+    return c;
+  };
+
+  /** Relocate mines so that (x,y) and its neighbors are guaranteed safe. */
+  Game.prototype._ensureSafeFirstClick = function (x, y) {
+    var safe = {};
+    safe[y * this.width + x] = true;
+    for (var dy = -1; dy <= 1; dy++) {
+      for (var dx = -1; dx <= 1; dx++) {
+        var nx = x + dx, ny = y + dy;
+        if (this._inBounds(nx, ny)) safe[ny * this.width + nx] = true;
+      }
+    }
+    var minesToMove = [];
+    var i, idx, c;
+    for (var key in safe) {
+      idx = +key;
+      c = this.cells[(idx / this.width) | 0][idx % this.width];
+      if (c.mine) minesToMove.push(idx);
+    }
+    if (!minesToMove.length) return;
+    // deterministic relocation: move each mine to the first non-safe,
+    // non-mine slot scanning the board, using seeded RNG for determinism
+    var rng = mulberry32((this.seed ^ 0x9E3779B9) >>> 0);
+    var used = {};
+    for (var s in safe) used[s] = true;
+    for (i = 0; i < minesToMove.length; i++) {
+      var fromIdx = minesToMove[i];
+      this.cells[(fromIdx / this.width) | 0][fromIdx % this.width].mine = false;
+      // find target slots: not safe, not already a mine, not used as target
+      var candidates = [];
+      for (idx = 0; idx < this.width * this.height; idx++) {
+        if (used[idx]) continue;
+        var cc = this.cells[(idx / this.width) | 0][idx % this.width];
+        if (!cc.mine) candidates.push(idx);
+      }
+      var toIdx = candidates[Math.floor(rng() * candidates.length)];
+      used[toIdx] = true;
+      this.cells[(toIdx / this.width) | 0][toIdx % this.width].mine = true;
+    }
+    // recompute neighbor counts
+    for (var yy = 0; yy < this.height; yy++) {
+      for (var xx = 0; xx < this.width; xx++) {
+        this.cells[yy][xx].neighborMines = this._countNeighbors(xx, yy);
+        this.cells[yy][xx].adjacentMines = this.cells[yy][xx].neighborMines;
+      }
+    }
+  };
+
+  Game.prototype.reveal = function (x, y) {
+    if (this.status !== 'playing') return { changed: [], status: this.status };
+    if (!this._inBounds(x, y)) return { changed: [], status: this.status };
+    var cell = this.cells[y][x];
+    if (cell.revealed || cell.flagged) return { changed: [], status: this.status };
+
+    if (this.firstClickPending) {
+      this.firstClickPending = false;
+      this._ensureSafeFirstClick(x, y);
+      cell = this.cells[y][x];
+    }
+
+    var changed = [];
+    if (cell.mine) {
+      cell.revealed = true;
+      changed.push(cell);
+      this.status = 'lost';
+      return { changed: changed, status: this.status, mine: true };
+    }
+
+    // iterative flood fill
+    var stack = [cell];
+    while (stack.length) {
+      var c = stack.pop();
+      if (c.revealed || c.flagged || c.mine) continue;
+      c.revealed = true;
+      this.revealedSafe++;
+      changed.push(c);
+      if (c.neighborMines === 0) {
+        for (var dy = -1; dy <= 1; dy++) {
+          for (var dx = -1; dx <= 1; dx++) {
+            if (dx === 0 && dy === 0) continue;
+            var nx = c.x + dx, ny = c.y + dy;
+            if (this._inBounds(nx, ny)) stack.push(this.cells[ny][nx]);
+          }
+        }
+      }
+    }
+
+    if (this.revealedSafe === this.safeCells) this.status = 'won';
+    return { changed: changed, status: this.status };
+  };
+
+  Game.prototype.toggleFlag = function (x, y) {
+    if (this.status !== 'playing') return this.status;
+    if (!this._inBounds(x, y)) return this.status;
+    var cell = this.cells[y][x];
+    if (cell.revealed) return this.status;
+    cell.flagged = !cell.flagged;
+    this.flags += cell.flagged ? 1 : -1;
+    return this.status;
+  };
+
+  Object.defineProperty(Game.prototype, 'flagsRemaining', {
+    get: function () { return this.mineCount - this.flags; }
+  });
+
+  Game.prototype.getStatus = function () { return this.status; };
+  Game.prototype.reset = function () { this.seed = this._initialSeed; this._init(); return this; };
+  Game.prototype.restart = Game.prototype.reset;
+  Game.prototype.newGame = Game.prototype.reset;
+
+  return {
+    createGame: createGame,
+    mulberry32: mulberry32,
+    WIDTH: WIDTH,
+    HEIGHT: HEIGHT,
+    MINES: MINES
+  };
+});
diff --git a/tests.js b/tests.js
new file mode 100644
index 0000000..5bf6ebd
--- /dev/null
+++ b/tests.js
@@ -0,0 +1,111 @@
+'use strict';
+/* Node tests for DOM-free Minesweeper game logic (game.js). */
+var assert = require('assert');
+var createGame = require('./game.js');
+
+function mineLayout(g) {
+  return g.cells.map(function (row) { return row.map(function (c) { return c.mine ? 1 : 0; }).join(''); }).join('|');
+}
+
+function indepNeighborCount(g, x, y) {
+  var n = 0;
+  for (var dy = -1; dy <= 1; dy++)
+    for (var dx = -1; dx <= 1; dx++) {
+      if (!dx && !dy) continue;
+      var nx = x + dx, ny = y + dy;
+      if (nx >= 0 && ny >= 0 && nx < g.width && ny < g.height && g.cells[ny][nx].mine) n++;
+    }
+  return n;
+}
+
+// 1. Determinism: same seed -> identical layout
+var a = createGame(42), b = createGame(42);
+assert.strictEqual(mineLayout(a), mineLayout(b), 'same seed gives identical layout');
+
+// 2. Different seed -> different layout (over several seeds)
+var layouts = {};
+var collision = false;
+for (var s = 1; s <= 20; s++) layouts[mineLayout(createGame(s))] = true;
+for (var s2 = 100; s2 <= 120; s2++) if (layouts[mineLayout(createGame(s2))]) collision = true;
+assert.ok(!collision, 'different seeds give different layouts');
+
+// 3. Board is 9x9 with 10 mines
+var g = createGame(7);
+assert.strictEqual(g.width, 9, 'width 9');
+assert.strictEqual(g.height, 9, 'height 9');
+assert.strictEqual(g.mineCount, 10, '10 mines');
+var mineTotal = 0;
+g.cells.forEach(function (row) { row.forEach(function (c) { if (c.mine) mineTotal++; }); });
+assert.strictEqual(mineTotal, 10, 'exactly 10 mines on board');
+
+// 4. Neighbor counts recomputed independently
+for (var y = 0; y < 9; y++)
+  for (var x = 0; x < 9; x++)
+    assert.strictEqual(g.cells[y][x].neighborMines, indepNeighborCount(g, x, y), 'neighbor count at ' + x + ',' + y);
+
+// 5. Safe first click: first revealed cell and its neighbors are never mines
+var allSafe = true;
+for (var seed = 1; seed <= 15; seed++) {
+  var gg = createGame(seed);
+  var fx = seed % 9, fy = (seed * 3) % 9;
+  gg.reveal(fx, fy);
+  for (var dy = -1; dy <= 1; dy++)
+    for (var dx = -1; dx <= 1; dx++) {
+      var nx = fx + dx, ny = fy + dy;
+      if (nx >= 0 && ny >= 0 && nx < 9 && ny < 9 && gg.cells[ny][nx].mine) allSafe = false;
+    }
+  if (gg.cells[fy][fx].mine) allSafe = false;
+}
+assert.ok(allSafe, 'first click and neighbors are never mines');
+
+// 6. Flood fill reveals >1 cell from an empty cell
+var fg = createGame(3);
+var ex = -1, ey = -1;
+outer:
+for (var y2 = 0; y2 < 9; y2++)
+  for (var x2 = 0; x2 < 9; x2++)
+    if (!fg.cells[y2][x2].mine && fg.cells[y2][x2].neighborMines === 0) { ex = x2; ey = y2; break outer; }
+assert.ok(ex >= 0, 'found an empty cell');
+fg.reveal(ex, ey);
+var revealedCount = 0;
+fg.cells.forEach(function (row) { row.forEach(function (c) { if (c.revealed) revealedCount++; }); });
+assert.ok(revealedCount > 1, 'flood fill reveals more than one cell, got ' + revealedCount);
+
+// 7. Flag toggle and flagsRemaining
+var tg = createGame(5);
+tg.toggleFlag(0, 0);
+assert.strictEqual(tg.cells[0][0].flagged, true, 'cell flagged');
+assert.strictEqual(tg.flagsRemaining, tg.mineCount - 1, 'flagsRemaining decremented');
+tg.toggleFlag(0, 0);
+assert.strictEqual(tg.cells[0][0].flagged, false, 'flag removed');
+assert.strictEqual(tg.flagsRemaining, tg.mineCount, 'flagsRemaining restored');
+
+// 8. Win by revealing all safe cells
+var wg = createGame(11);
+for (var y3 = 0; y3 < 9 && wg.status === 'playing'; y3++)
+  for (var x3 = 0; x3 < 9 && wg.status === 'playing'; x3++)
+    if (!wg.cells[y3][x3].mine) wg.reveal(x3, y3);
+assert.strictEqual(wg.status, 'won', 'win after revealing all safe cells');
+
+// 9. Loss by revealing a mine
+var lg = createGame(11);
+var mx = -1, my = -1;
+for (var y4 = 0; y4 < 9 && mx < 0; y4++)
+  for (var x4 = 0; x4 < 9; x4++)
+    if (lg.cells[y4][x4].mine) { mx = x4; my = y4; break; }
+lg.reveal(mx, my);
+assert.strictEqual(lg.status, 'lost', 'loss after revealing a mine');
+
+// 10. Reset restores fresh state: 81 hidden cells, 10 mines, playing
+var rg = createGame(9);
+rg.reveal(4, 4); rg.toggleFlag(0, 0);
+var resetFn = rg.reset || rg.restart || rg.newGame;
+assert.strictEqual(typeof resetFn, 'function', 'a reset method exists');
+resetFn.call(rg);
+assert.strictEqual(rg.status, 'playing', 'status playing after reset');
+var hidden = 0, mines2 = 0;
+rg.cells.forEach(function (row) { row.forEach(function (c) { if (!c.revealed) hidden++; if (c.mine) mines2++; }); });
+assert.strictEqual(hidden, 81, 'all 81 cells hidden after reset');
+assert.strictEqual(mines2, 10, '10 mines after reset');
+
+console.log('All tests passed.');
