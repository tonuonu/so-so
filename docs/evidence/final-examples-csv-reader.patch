 function parseCSV(text) {
-  return text.split('\n').map(line => line.split(','));
+  if (text.length === 0) return [];
+
+  const records = [];
+  let record = [];
+  let field = '';
+  let quoted = false;
+  let endedWithSeparator = false;
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
