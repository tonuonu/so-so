+      if (char === '\r') i++;
+      record.push(field);
+      records.push(record);
+      record = [];
+      field = '';
+      endedWithSeparator = true;
+    } else {
+      field += char;
+    }
+  }
+
+  if (quoted) throw new Error('Unterminated quoted field');
+  if (!endedWithSeparator) {
+    record.push(field);
+    records.push(record);
+  }
