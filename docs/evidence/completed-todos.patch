+#!/usr/bin/env python3
+"""Persistent todo HTTP service (Python standard library only).
+
+Usage:
+    python3 server.py --port 8000 --file todos.json
+"""
+
+import argparse
+import json
+import os
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import urlsplit
+
+_lock = threading.Lock()
+_todos = []
+_next_id = 1
+_file_path = None
+
+
+def load_state(path):
+    global _todos, _next_id
+    if path and os.path.exists(path):
+        try:
+            with open(path, "r", encoding="utf-8") as f:
+                data = json.load(f)
+            if isinstance(data, list):
+                _todos = [t for t in data if isinstance(t, dict) and "id" in t and "title" in t]
+                ids = [t["id"] for t in _todos if isinstance(t["id"], int)]
+                _next_id = (max(ids) + 1) if ids else 1
+        except (OSError, ValueError):
+            _todos = []
+            _next_id = 1
+
+
+def persist():
+    if not _file_path:
+        return
+    tmp = _file_path + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(_todos, f)
+    os.replace(tmp, _file_path)
+
+
+def send_json(handler, status, payload):
+    body = json.dumps(payload).encode("utf-8")
+    handler.send_response(status)
+    handler.send_header("Content-Type", "application/json")
+    handler.send_header("Content-Length", str(len(body)))
+    handler.end_headers()
+    if body:
+        handler.wfile.write(body)
+
+
+class TodoHandler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def log_message(self, *args):
+        pass
+
+    def _read_body(self):
+        length = int(self.headers.get("Content-Length") or 0)
+        raw = self.rfile.read(length) if length else b""
+        try:
+            return json.loads(raw.decode("utf-8"))
+        except (ValueError, UnicodeDecodeError):
+            return None
+
+    def do_GET(self):
+        if self.path == "/health":
+            send_json(self, 200, {"status": "ok"})
+        elif self.path == "/todos":
+            with _lock:
+                items = list(_todos)
+            send_json(self, 200, items)
+        else:
+            send_json(self, 404, {"error": "not found"})
+
+    def do_POST(self):
+        if self.path != "/todos":
+            send_json(self, 404, {"error": "not found"})
+            return
+        data = self._read_body()
+        if not isinstance(data, dict) or not isinstance(data.get("title"), str) or not data["title"].strip():
+            send_json(self, 400, {"error": "title must be a non-empty string"})
+            return
+        global _next_id
+        with _lock:
+            item = {"id": _next_id, "title": data["title"], "completed": False}
+            _next_id += 1
+            _todos.append(item)
+            persist()
+        send_json(self, 201, item)
+
+    def do_PATCH(self):
+        parts = [p for p in urlsplit(self.path).path.split("/") if p]
+        if len(parts) != 2 or parts[0] != "todos":
+            send_json(self, 404, {"error": "not found"})
+            return
+        try:
+            item_id = int(parts[1])
+        except ValueError:
+            send_json(self, 404, {"error": "not found"})
+            return
+        data = self._read_body()
+        if not isinstance(data, dict) or not isinstance(data.get("completed"), bool):
+            send_json(self, 400, {"error": "payload must be {'completed': bool}"})
+            return
+        with _lock:
+            for item in _todos:
+                if item["id"] == item_id:
+                    item["completed"] = data["completed"]
+                    persist()
+                    send_json(self, 200, dict(item))
+                    return
+        send_json(self, 404, {"error": "not found"})
+
+    def do_DELETE(self):
+        parts = [p for p in urlsplit(self.path).path.split("/") if p]
+        if len(parts) != 2 or parts[0] != "todos":
+            send_json(self, 404, {"error": "not found"})
+            return
+        try:
+            item_id = int(parts[1])
+        except ValueError:
+            send_json(self, 404, {"error": "not found"})
+            return
+        with _lock:
+            for i, item in enumerate(_todos):
+                if item["id"] == item_id:
+                    del _todos[i]
+                    persist()
+                    self.send_response(204)
+                    self.send_header("Content-Length", "0")
+                    self.end_headers()
+                    return
+        send_json(self, 404, {"error": "not found"})
+
+
+def main():
+    global _file_path
+    parser = argparse.ArgumentParser(description="Persistent todo HTTP service")
+    parser.add_argument("--port", type=int, default=8000)
+    parser.add_argument("--file", default="todos.json")
+    parser.add_argument("--host", default="127.0.0.1")
+    args = parser.parse_args()
+    _file_path = args.file
+    load_state(args.file)
+    server = ThreadingHTTPServer((args.host, args.port), TodoHandler)
+    print(f"Serving on http://{args.host}:{args.port} (file={args.file})")
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
