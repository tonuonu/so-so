+#!/usr/bin/env python3
+"""HTTP integration tests for server.py.
+
+Each test starts the server as a subprocess on a loopback port with a
+temporary persistence file and exercises the real HTTP API via urllib.
+"""
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+import urllib.error
+import urllib.request
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SERVER = os.path.join(ROOT, "server.py")
+
+
+class ServerCase(unittest.TestCase):
+    port = 18099
+
+    @classmethod
+    def setUpClass(cls):
+        cls.tmpdir = tempfile.TemporaryDirectory()
+        cls.datafile = os.path.join(cls.tmpdir.name, "todos.json")
+        cls.proc = subprocess.Popen(
+            [sys.executable, SERVER, "--port", str(cls.port), "--file", cls.datafile],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+        )
+        # wait for health
+        deadline = time.time() + 10
+        while time.time() < deadline:
+            try:
+                if cls.request("GET", "/health")[0] == 200:
+                    return
+            except OSError:
+                time.sleep(0.05)
+        cls.tearDownClass()
+        raise RuntimeError("server did not start")
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.proc.terminate()
+        try:
+            cls.proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            cls.proc.kill()
+        cls.tmpdir.cleanup()
+
+    @classmethod
+    def request(cls, method, path, body=None, raw=None):
+        url = f"http://127.0.0.1:{cls.port}{path}"
+        data = raw if raw is not None else (
+            json.dumps(body).encode() if body is not None else None)
+        req = urllib.request.Request(url, data=data, method=method,
+                                     headers={"Content-Type": "application/json"})
+        try:
+            with urllib.request.urlopen(req) as resp:
+                payload = resp.read()
+                return resp.status, json.loads(payload) if payload else None
+        except urllib.error.HTTPError as e:
+            payload = e.read()
+            try:
+                parsed = json.loads(payload) if payload else None
+            except json.JSONDecodeError:
+                parsed = None
+            return e.code, parsed
+
+    def setUp(self):
+        # clean slate for each test
+        for _, todos in [self.request("GET", "/todos")]:
+            for item in todos or []:
+                self.request("DELETE", f"/todos/{item['id']}")
+
+    def test_health(self):
+        status, body = self.request("GET", "/health")
+        self.assertEqual(status, 200)
+        self.assertEqual(body, {"status": "ok"})
+
+    def test_create_and_list(self):
+        status, item = self.request("POST", "/todos", {"title": "buy milk"})
+        self.assertEqual(status, 201)
+        self.assertEqual(item["title"], "buy milk")
+        self.assertFalse(item["completed"])
+        self.assertIn("id", item)
+        status, todos = self.request("GET", "/todos")
+        self.assertEqual(status, 200)
+        self.assertIsInstance(todos, list)
+        self.assertEqual(len(todos), 1)
+
+    def test_unique_ids(self):
+        _, a = self.request("POST", "/todos", {"title": "a"})
+        _, b = self.request("POST", "/todos", {"title": "b"})
+        self.assertNotEqual(a["id"], b["id"])
+
+    def test_post_bad_json(self):
+        status, _ = self.request("POST", "/todos", raw=b"{not json")
+        self.assertEqual(status, 400)
+
+    def test_post_empty_title(self):
+        for bad in ({"title": ""}, {"title": 5}, {}):
+            status, _ = self.request("POST", "/todos", bad)
+            self.assertEqual(status, 400, bad)
+
+    def test_patch(self):
+        _, item = self.request("POST", "/todos", {"title": "x"})
+        status, updated = self.request(
+            "PATCH", f"/todos/{item['id']}", {"completed": True})
+        self.assertEqual(status, 200)
+        self.assertTrue(updated["completed"])
+
+    def test_patch_errors(self):
+        status, _ = self.request("PATCH", "/todos/99999", {"completed": True})
+        self.assertEqual(status, 404)
+        _, item = self.request("POST", "/todos", {"title": "x"})
+        status, _ = self.request("PATCH", f"/todos/{item['id']}", {"completed": "yes"})
+        self.assertEqual(status, 400)
+
+    def test_delete(self):
+        _, item = self.request("POST", "/todos", {"title": "x"})
+        status, _ = self.request("DELETE", f"/todos/{item['id']}")
+        self.assertEqual(status, 204)
+        status, todos = self.request("GET", "/todos")
+        self.assertEqual(todos, [])
+        status, _ = self.request("DELETE", f"/todos/{item['id']}")
+        self.assertEqual(status, 404)
+
+    def test_patch_with_query_string(self):
+        _, item = self.request("POST", "/todos", {"title": "qs"})
+        status, updated = self.request(
+            "PATCH", f"/todos/{item['id']}?x=1", {"completed": True})
+        self.assertEqual(status, 200)
+        self.assertTrue(updated["completed"])
+
+    def test_delete_with_query_string(self):
+        _, item = self.request("POST", "/todos", {"title": "qs"})
+        status, _ = self.request("DELETE", f"/todos/{item['id']}?x=1")
+        self.assertEqual(status, 204)
+
+    def test_unknown_path(self):
+        status, _ = self.request("GET", "/nope")
+        self.assertEqual(status, 404)
+        status, _ = self.request("DELETE", "/todos")
+        self.assertEqual(status, 404)
+
+    def test_persistence_across_restart(self):
+        _, item = self.request("POST", "/todos", {"title": "persist me"})
+        self.proc.terminate()
+        self.proc.wait(timeout=5)
+        self.proc = subprocess.Popen(
+            [sys.executable, SERVER, "--port", str(self.port), "--file", self.datafile],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        deadline = time.time() + 10
+        while True:
+            try:
+                if self.request("GET", "/health")[0] == 200:
+                    break
+            except OSError:
+                if time.time() > deadline:
+                    self.fail("server did not restart")
+                time.sleep(0.05)
+        status, todos = self.request("GET", "/todos")
+        self.assertEqual(todos, [item])
+
+
+if __name__ == "__main__":
+    unittest.main()
